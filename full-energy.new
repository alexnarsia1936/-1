<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Full Energy — Здоровье и Красота</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Montserrat', sans-serif; -webkit-tap-highlight-color: transparent; }
    html, body { width: 100%; height: 100%; overflow: hidden; background-color: #0f172a; color: #1e293b; }
    
    .app-wrapper { width: 100vw; height: 100vh; display: flex; flex-direction: column; justify-content: space-between; padding: 14px; }
    
    /* Экран слайда */
    .slide-card { flex: 1; background: #ffffff; border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.35); overflow-y: auto; display: none; flex-direction: column; justify-content: space-between; padding: 24px; animation: fadeIn 0.3s ease; }
    .slide-card.active { display: flex; }
    
    @keyframes fadeIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }
    
    /* Заголовки - крупнее и сочнее */
    .tag { display: inline-block; font-size: 14px; font-weight: 900; color: #d97706; text-transform: uppercase; letter-spacing: 1.2px; margin-bottom: 8px; }
    .title { font-size: 25px; font-weight: 900; color: #0f172a; line-height: 1.35; margin-bottom: 16px; }
    
    /* Содержимое - усиленная толщина (weight 700) и насыщенный тёмный цвет (#0f172a) */
    .content p { font-size: 17px; font-weight: 700; color: #0f172a; line-height: 1.6; margin-bottom: 14px; }
    
    /* Карточки на слайдах */
    .card-box { background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border: 2px solid #f59e0b; border-radius: 18px; padding: 18px; text-align: center; margin-top: 12px; }
    .card-box i { font-size: 40px; color: #d97706; margin-bottom: 10px; }
    .card-box h4 { font-size: 19px; color: #78350f; font-weight: 900; margin-bottom: 6px; }
    .card-box p { font-size: 15px; font-weight: 700; color: #78350f; margin-bottom: 0; line-height: 1.45; }
    
    /* Грид список - плотные читаемые шрифты */
    .list-grid { display: flex; flex-direction: column; gap: 12px; margin-top: 10px; }
    .list-item { background: #f1f5f9; border-left: 6px solid #f59e0b; padding: 14px 16px; border-radius: 0 14px 14px 0; box-shadow: 0 2px 6px rgba(0,0,0,0.03); }
    .list-item h5 { font-size: 17px; color: #0f172a; font-weight: 900; margin-bottom: 4px; }
    .list-item p { font-size: 15px; color: #1e293b; font-weight: 700; margin-bottom: 0; line-height: 1.5; }

    /* Главный титульный */
    .hero-slide { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #ffffff; text-align: center; justify-content: center; }
    .hero-slide .title { color: #ffffff; font-size: 29px; font-weight: 900; line-height: 1.3; }
    .hero-slide p { color: #e2e8f0; font-size: 18px; font-weight: 700; line-height: 1.5; }
    
    /* Кнопка чата MAX */
    .btn-max { background: #f59e0b; color: #0f172a; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 16px; border-radius: 30px; font-weight: 900; font-size: 17px; margin-top: 20px; box-shadow: 0 6px 16px rgba(245, 158, 11, 0.45); }
    
    /* Нижняя панель */
    .controls { display: flex; align-items: center; justify-content: space-between; background: #1e293b; padding: 12px 20px; border-radius: 35px; margin-top: 12px; }
    .btn-nav { background: #334155; color: white; border: none; width: 48px; height: 48px; border-radius: 50%; font-size: 20px; display: flex; align-items: center; justify-content: center; }
    .btn-nav:active { background: #f59e0b; color: #0f172a; }
    .counter { color: #ffffff; font-weight: 900; font-size: 17px; }
  </style>
</head>
<body>

<div class="app-wrapper" id="app">
  
  <!-- Слайд 1 -->
  <div class="slide-card hero-slide active">
    <div>
      <span class="tag" style="color:#f59e0b;">Официальный Партнер</span>
      <h1 class="title">Как я использую продукцию Full Energy</h1>
      <p>Секреты бодрости, активности и естественной красоты на каждый день</p>
    </div>
    <div style="margin-top: 20px;">
      <i class="fa-solid fa-bolt" style="font-size: 48px; color: #f59e0b;"></i>
    </div>
  </div>

  <!-- Слайд 2 -->
  <div class="slide-card">
    <div>
      <span class="tag">Философия бренда</span>
      <h2 class="title">Энергия в каждой клетке</h2>
      <div class="content">
        <p>Современный ритм требует максимум сил. Линия <strong>Full Energy</strong> разработана для того, чтобы ваш организм работал без сбоев и усталости.</p>
      </div>
    </div>
    <div class="card-box">
      <i class="fa-solid fa-atom"></i>
      <h4>Инновации & Природа</h4>
      <p>Высокие стандарты качества для вашей естественной привлекательности.</p>
    </div>
  </div>

  <!-- Слайд 3 -->
  <div class="slide-card">
    <div>
      <span class="tag">Здоровье & Тонус</span>
      <h2 class="title">Заряд энергии 24/7</h2>
    </div>
    <div class="list-grid">
      <div class="list-item">
        <h5>Крепкий иммунитет</h5>
        <p>Защита организма в период физических и умственных нагрузок.</p>
      </div>
      <div class="list-item">
        <h5>Бодрость без перепадов</h5>
        <p>Поддержка активности без резких упадков сил.</p>
      </div>
      <div class="list-item">
        <h5>Легкость и метаболизм</h5>
        <p>Оптимизация внутренних процессов обмена веществ.</p>
      </div>
    </div>
  </div>

  <!-- Слайд 4 -->
  <div class="slide-card">
    <div>
      <span class="tag">Красота & Уход</span>
      <h2 class="title">Сияние вашей кожи</h2>
      <div class="content">
        <p>Настоящая красота идёт изнутри. Продукты <strong>Full Energy</strong> поддерживают упругость кожи, блеск волос и свежесть лица.</p>
      </div>
    </div>
    <div class="card-box" style="background: linear-gradient(135deg, #fce7f3 0%, #fbcfe8 100%); border-color: #ec4899;">
      <i class="fa-solid fa-sparkles" style="color: #db2777;"></i>
      <h4 style="color: #9d174d;">Клеточное обновление</h4>
      <p style="color: #831843;">Антиоксидантная защита молодости на каждый день.</p>
    </div>
  </div>

  <!-- Слайд 5 -->
  <div class="slide-card">
    <div>
      <span class="tag">Личный опыт</span>
      <h2 class="title">Мой ежедневный ритуал</h2>
    </div>
    <div class="list-grid">
      <div class="list-item">
        <h5>1. Утро</h5>
        <p>Запуск энергии и фокус на новые задачи.</p>
      </div>
      <div class="list-item">
        <h5>2. День</h5>
        <p>Поддержка высокого тонуса без стресса.</p>
      </div>
      <div class="list-item">
        <h5>3. Вечер</h5>
        <p>Восстановление сил и релакс уход.</p>
      </div>
    </div>
  </div>

  <!-- Слайд 6 -->
  <div class="slide-card hero-slide">
    <div>
      <span class="tag" style="color:#f59e0b;">Присоединяйтесь</span>
      <h2 class="title">Выбирайте Full Energy!</h2>
      <p>Свяжитесь со мной как с партнером компании для заказа и подробной консультации!</p>
    </div>
    <a href="https://max.ru/u/f9LHodD0cOLE_J2OYd-GY72YFLcfUn30sff834wGd20-SjrI08gKGf4aiaM" class="btn-max" target="_blank">
      <i class="fa-solid fa-comments"></i> Написать в чат MAX
    </a>
  </div>

  <!-- Навигация -->
  <div class="controls">
    <button class="btn-nav" onclick="prev()"><i class="fa-solid fa-chevron-left"></i></button>
    <div class="counter" id="num">1 / 6</div>
    <button class="btn-nav" onclick="next()"><i class="fa-solid fa-chevron-right"></i></button>
  </div>

</div>

<script>
  let idx = 0;
  const slides = document.querySelectorAll('.slide-card');
  const num = document.getElementById('num');

  function show(n) {
    slides.forEach((s, i) => s.classList.toggle('active', i === n));
    num.innerText = `${n + 1} / ${slides.length}`;
  }

  function next() { if (idx < slides.length - 1) { idx++; show(idx); } }
  function prev() { if (idx > 0) { idx--; show(idx); } }

  // Свайпы для мобильных телефонов
  let startX = 0;
  const app = document.getElementById('app');
  app.addEventListener('touchstart', e => startX = e.touches[0].clientX);
  app.addEventListener('touchend', e => {
    let diff = startX - e.changedTouches[0].clientX;
    if (diff > 40) next();
    if (diff < -40) prev();
  });
</script>

</body>
</html>
